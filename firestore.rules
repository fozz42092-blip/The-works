                       ]) &&
                       isValidSupplyOrder(incoming());
      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidSupplyOrder(incoming()) &&
                       existing().userId == request.auth.uid &&
                       existing().status == 'submitted' &&
                       incoming().status == 'cancelled' &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    match /iicrc_audits/{auditId} {
      allow get: if isSignedIn() && isValidId(auditId);
      allow list: if isSignedIn() && existing().isPublic == true;
      allow create: if isSignedIn() &&
                       isValidId(auditId) &&
                       incoming().contractorUserId == request.auth.uid &&
                       incoming().iicrcStatus == 'pending_iicrc' &&
                       incoming().iicrcInspectorUid == '' &&
                       incoming().keys().hasAll([
                         'consultationId', 'reportId', 'contractorUserId', 'contractorName', 'city',
                         'lossCategory', 'proposedVerdict', 'contractorSuggestion', 'contractorStrategy',
                         'aiCreditLinks', 'proposedWorkEstimateUsd', 'isPublic', 'iicrcStatus',
                         'iicrcStandardRef', 'iicrcInspectorUid', 'iicrcInspectorName',
                         'iicrcGovernorNotes', 'iicrcSources', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'consultationId', 'reportId', 'contractorUserId', 'contractorName', 'city',
                         'lossCategory', 'proposedVerdict', 'contractorSuggestion', 'contractorStrategy',
                         'aiCreditLinks', 'proposedWorkEstimateUsd', 'isPublic', 'iicrcStatus',
                         'iicrcStandardRef', 'iicrcInspectorUid', 'iicrcInspectorName',
                         'iicrcGovernorNotes', 'iicrcSources', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidIicrcAudit(incoming()) &&
                       exists(/databases/$(database)/documents/contractors/$(request.auth.uid));
      allow update: if isSignedIn() &&
                       isValidId(auditId) &&
                       isValidIicrcAudit(incoming()) &&
                       existing().contractorUserId != request.auth.uid &&
                       incoming().contractorUserId == existing().contractorUserId &&
                       incoming().consultationId == existing().consultationId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().iicrcInspectorUid == request.auth.uid &&
                       exists(/databases/$(database)/documents/contractors/$(request.auth.uid)) &&
                       (get(/databases/$(database)/documents/contractors/$(request.auth.uid)).data.specialty == 'iicrc_inspector' ||
                        get(/databases/$(database)/documents/contractors/$(request.auth.uid)).data.isIicrcGovernor == true) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'iicrcStatus', 'iicrcStandardRef', 'iicrcInspectorUid',
                         'iicrcInspectorName', 'iicrcGovernorNotes', 'iicrcSources', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    match /contractor_complaints/{complaintId} {
      allow get: if isSignedIn() && isValidId(complaintId) && existing().isPublic == true;
      allow list: if isSignedIn() && existing().isPublic == true;
      allow create: if isSignedIn() &&
                       isValidId(complaintId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'filed' &&
                       incoming().keys().hasAll([
                         'userId', 'complainantName', 'contractorUserId', 'contractorName',
                         'companyName', 'licenseNumber', 'iicrcCertNumber', 'isRestorationCompany',
                         'city', 'complaintCategory', 'summary', 'evidenceNotes', 'proofPhotoBase64',
                         'routedToSocalCslb', 'routedToIicrc', 'cslbIntakeUrl', 'iicrcIntakeUrl',
                         'status', 'isPublic', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'complainantName', 'contractorUserId', 'contractorName',
                         'companyName', 'licenseNumber', 'iicrcCertNumber', 'isRestorationCompany',
                         'city', 'complaintCategory', 'summary', 'evidenceNotes', 'proofPhotoBase64',
                         'routedToSocalCslb', 'routedToIicrc', 'cslbIntakeUrl', 'iicrcIntakeUrl',
                         'status', 'isPublic', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidContractorComplaint(incoming()) &&
                       (incoming().contractorUserId == 'external' ||
                        exists(/databases/$(database)/documents/contractors/$(incoming().contractorUserId)));
      allow update: if isSignedIn() &&
                       isValidId(complaintId) &&
                       isValidContractorComplaint(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().contractorUserId == existing().contractorUserId &&
                       incoming().createdAt == existing().createdAt && (
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'evidenceNotes', 'updatedAt'
                          ])) ||
                         (existing().isRestorationCompany == true &&
                          existing().contractorUserId != request.auth.uid &&
                          exists(/databases/$(database)/documents/contractors/$(request.auth.uid)) &&
                          (get(/databases/$(database)/documents/contractors/$(request.auth.uid)).data.specialty == 'iicrc_inspector' ||
                           get(/databases/$(database)/documents/contractors/$(request.auth.uid)).data.isIicrcGovernor == true) &&
                          incoming().status in ['iicrc_reviewing', 'resolved'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'evidenceNotes', 'updatedAt'
                          ]))
                       );
      allow delete: if isSignedIn() && isValidId(complaintId) && existing().userId == request.auth.uid;
    }

    match /insurance_carriers/{carrierId} {
      allow get: if isSignedIn() && isValidId(carrierId) &&
                    (request.auth.uid == carrierId || (resource != null && existing().isActive == true));
      allow list: if isSignedIn() && (existing().isActive == true || existing().userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(carrierId) &&
                       request.auth.uid == carrierId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'carrierName', 'adjusterName', 'licenseOrNaicCode', 'claimsEmail',
                         'claimsPhone', 'claimsPortalUrl', 'serviceRegions',
                         'supportsDirectRestorationBilling', 'avgTurnaroundHours', 'bio', 'isActive',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'carrierName', 'adjusterName', 'licenseOrNaicCode', 'claimsEmail',
                         'claimsPhone', 'claimsPortalUrl', 'serviceRegions',
                         'supportsDirectRestorationBilling', 'avgTurnaroundHours', 'bio', 'isActive',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidInsuranceCarrier(incoming());
      allow update: if isSignedIn() &&
                       isValidId(carrierId) &&
                       request.auth.uid == carrierId &&
                       existing().userId == request.auth.uid &&
                       isValidInsuranceCarrier(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'carrierName', 'adjusterName', 'licenseOrNaicCode', 'claimsEmail',
                         'claimsPhone', 'claimsPortalUrl', 'serviceRegions',
                         'supportsDirectRestorationBilling', 'avgTurnaroundHours', 'bio', 'isActive',
                         'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(carrierId) && request.auth.uid == carrierId;
    }

    match /insurance_claims/{claimId} {
      allow get: if isSignedIn() && isValidId(claimId) &&
                    (existing().clientUserId == request.auth.uid ||
                     existing().contractorUserId == request.auth.uid ||
                     existing().insurerUserId == request.auth.uid);
      allow list: if isSignedIn() &&
                     (existing().clientUserId == request.auth.uid ||
                      existing().contractorUserId == request.auth.uid ||
                      existing().insurerUserId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(claimId) &&
                       incoming().clientUserId == request.auth.uid &&
                       incoming().approvedCoverageUsd == 0 &&
                       incoming().lastMessageFromRole == 'client' &&
                       incoming().keys().hasAll([
                         'clientUserId', 'clientName', 'contractorUserId', 'contractorName',
                         'insurerUserId', 'insurerName', 'claimNumber', 'policyType', 'deductibleUsd',
                         'reportId', 'consultationId', 'city', 'lossCategory',
                         'contractorSuggestion', 'estimatedScopeUsd', 'approvedCoverageUsd',
                         'claimStatus', 'lastMessageFromRole', 'communicationLog', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'clientUserId', 'clientName', 'contractorUserId', 'contractorName',
                         'insurerUserId', 'insurerName', 'claimNumber', 'policyType', 'deductibleUsd',
                         'reportId', 'consultationId', 'city', 'lossCategory',
                         'contractorSuggestion', 'estimatedScopeUsd', 'approvedCoverageUsd',
                         'claimStatus', 'lastMessageFromRole', 'communicationLog', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidInsuranceClaim(incoming()) &&
                       (incoming().insurerUserId == 'external_carrier' ||
                        exists(/databases/$(database)/documents/insurance_carriers/$(incoming().insurerUserId))) &&
                       (incoming().contractorUserId == '' ||
                        exists(/databases/$(database)/documents/contractors/$(incoming().contractorUserId)));
      allow update: if isSignedIn() &&
                       isValidId(claimId) &&
                       isValidInsuranceClaim(incoming()) &&
                       incoming().clientUserId == existing().clientUserId &&
                       incoming().createdAt == existing().createdAt && (
                         (request.auth.uid == existing().clientUserId &&
                          incoming().lastMessageFromRole == 'client' &&
                          incoming().approvedCoverageUsd == existing().approvedCoverageUsd &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'contractorUserId', 'contractorName', 'claimStatus',
                            'lastMessageFromRole', 'communicationLog', 'updatedAt'
                          ])) ||
                         (request.auth.uid == existing().contractorUserId &&
                          existing().contractorUserId != '' &&
                          incoming().lastMessageFromRole == 'contractor' &&
                          incoming().approvedCoverageUsd == existing().approvedCoverageUsd &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'contractorSuggestion', 'estimatedScopeUsd', 'claimStatus',
                            'lastMessageFromRole', 'communicationLog', 'updatedAt'
                          ])) ||
                         (request.auth.uid == existing().insurerUserId &&
                          existing().insurerUserId != 'external_carrier' &&
                          incoming().lastMessageFromRole == 'insurer' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'approvedCoverageUsd', 'claimStatus', 'lastMessageFromRole',
                            'communicationLog', 'updatedAt'
                          ]))
                       );
      allow delete: if false;
    }

    match /saved_properties/{propId} {
      allow get: if isSignedIn() && isValidId(propId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(propId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'label', 'propertyType', 'address', 'city', 'state',
                         'latitude', 'longitude', 'femaFloodZone', 'fireHazardZone',
                         'waterTableDepthFt', 'hazardSummary', 'notifyPriorityAlerts', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'label', 'propertyType', 'address', 'city', 'state',
                         'latitude', 'longitude', 'femaFloodZone', 'fireHazardZone',
                         'waterTableDepthFt', 'hazardSummary', 'notifyPriorityAlerts', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSavedProperty(incoming());
      allow update: if isSignedIn() &&
                       isValidId(propId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSavedProperty(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'notifyPriorityAlerts', 'label', 'femaFloodZone', 'fireHazardZone', 'hazardSummary', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(propId) && existing().userId == request.auth.uid;
    }

    match /contractor_product_reviews/{revId} {
      allow get: if isSignedIn() && isValidId(revId) &&
                    (existing().isPublic == true || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (existing().isPublic == true || existing().userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       isValidId(revId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'contractorName', 'companyName', 'licenseNumber',
                         'productSku', 'productName', 'brandModel', 'category', 'disasterUseCase',
                         'rating', 'jobsUsedCount', 'pros', 'cons', 'honestReview',
                         'wouldUseOnInsuredJob', 'isPublic', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'contractorName', 'companyName', 'licenseNumber',
                         'productSku', 'productName', 'brandModel', 'category', 'disasterUseCase',
                         'rating', 'jobsUsedCount', 'pros', 'cons', 'honestReview',
                         'wouldUseOnInsuredJob', 'isPublic', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidContractorProductReview(incoming());
      allow update, delete: if isSignedIn() && isValidId(revId) && existing().userId == request.auth.uid;
    }

    match /equipment_rentals/{rentalId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(rentalId) &&
                       incoming().ownerUserId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerUserId', 'ownerName', 'ownerType', 'companyName', 'equipmentName',
                         'category', 'city', 'dailyRateUsd', 'depositUsd', 'specs',
                         'contactPhoneOrNote', 'isAvailable', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUserId', 'ownerName', 'ownerType', 'companyName', 'equipmentName',
                         'category', 'city', 'dailyRateUsd', 'depositUsd', 'specs',
                         'contactPhoneOrNote', 'isAvailable', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidEquipmentRental(incoming());
      allow update: if isSignedIn() &&
                       isValidId(rentalId) &&
                       existing().ownerUserId == request.auth.uid &&
                       incoming().ownerUserId == existing().ownerUserId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidEquipmentRental(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'isAvailable', 'dailyRateUsd', 'depositUsd', 'specs', 'contactPhoneOrNote', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(rentalId) && existing().ownerUserId == request.auth.uid;
    }

    match /app_revision_suggestions/{suggestionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       isValidId(suggestionId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().upvotesCount == 0 &&
                       incoming().status == 'submitted' &&
                       incoming().keys().hasAll([
                         'userId', 'authorName', 'authorRole', 'tradeOrSpecialty',
                         'title', 'category', 'description', 'upvotesCount', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'authorName', 'authorRole', 'tradeOrSpecialty',
                         'title', 'category', 'description', 'upvotesCount', 'status',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidAppRevisionSuggestion(incoming());
      allow update: if isSignedIn() &&
                       isValidId(suggestionId) &&
                       isValidAppRevisionSuggestion(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         (existing().userId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'updatedAt'])) ||
                         (incoming().upvotesCount == existing().upvotesCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(suggestionId) && existing().userId == request.auth.uid;
    }

    match /hygienist_requests/{reqId} {
      allow get: if isSignedIn() && isValidId(reqId) &&
                    (existing().clientUserId == request.auth.uid ||
                     existing().hygienistUserId == request.auth.uid ||
                     existing().hygienistUserId == 'open_marketplace');
      allow list: if isSignedIn() &&
                     (existing().clientUserId == request.auth.uid ||
                      existing().hygienistUserId == request.auth.uid ||
                      existing().hygienistUserId == 'open_marketplace');
      allow create: if isSignedIn() &&
                       isValidId(reqId) &&
                       incoming().clientUserId == request.auth.uid &&
                       incoming().status == 'requested' &&
                       incoming().quotedFeeUsd == 0 &&
                       incoming().keys().hasAll([
                         'clientUserId', 'clientName', 'hygienistUserId', 'hygienistName',
                         'city', 'propertyAddressHint', 'sampleTypes', 'reasonNotes',
                         'status', 'quotedFeeUsd', 'labFindingsSummary', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'clientUserId', 'clientName', 'hygienistUserId', 'hygienistName',
                         'city', 'propertyAddressHint', 'sampleTypes', 'reasonNotes',
                         'status', 'quotedFeeUsd', 'labFindingsSummary', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidHygienistRequest(incoming());
      allow update: if isSignedIn() &&
                       isValidId(reqId) &&
                       isValidHygienistRequest(incoming()) &&
                       incoming().clientUserId == existing().clientUserId &&
                       incoming().createdAt == existing().createdAt && (
                         (existing().clientUserId == request.auth.uid &&
                          incoming().status == 'cancelled' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (existing().clientUserId != request.auth.uid &&
                          (existing().hygienistUserId == 'open_marketplace' || existing().hygienistUserId == request.auth.uid) &&
                          exists(/databases/$(database)/documents/contractors/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/contractors/$(request.auth.uid)).data.specialty in [
                            'industrial_hygienist', 'iicrc_inspector', 'mold_remediation', 'full_service_restoration'
                          ] &&
                          incoming().hygienistUserId == request.auth.uid &&
                          incoming().status in ['accepted', 'sampled', 'lab_report_ready'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'hygienistUserId', 'hygienistName', 'status', 'quotedFeeUsd', 'labFindingsSummary', 'updatedAt'
                          ]))
                       );
      allow delete: if isSignedIn() && isValidId(reqId) && existing().clientUserId == request.auth.uid;
    }

    match /insurance_policies/{policyId} {
      allow get: if isSignedIn() && isValidId(policyId) &&
                    (existing().insurerUserId == request.auth.uid ||
                     existing().clientUserId == request.auth.uid ||
                     existing().clientUserId == 'open_quote');
      allow list: if isSignedIn() &&
                     (existing().insurerUserId == request.auth.uid ||
                      existing().clientUserId == request.auth.uid ||
                      existing().clientUserId == 'open_quote');
      allow create: if isSignedIn() &&
                       isValidId(policyId) &&
                       incoming().keys().hasAll([
                         'insurerUserId', 'carrierName', 'clientUserId', 'clientName',
                         'propertyLabel', 'city', 'coverageType', 'coverageLimitUsd',
                         'deductibleUsd', 'baseMonthlyPremiumUsd', 'telemetryDiscountPercent',
                         'discountedMonthlyPremiumUsd', 'policyTermsSummary', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'insurerUserId', 'carrierName', 'clientUserId', 'clientName',
                         'propertyLabel', 'city', 'coverageType', 'coverageLimitUsd',
                         'deductibleUsd', 'baseMonthlyPremiumUsd', 'telemetryDiscountPercent',
                         'discountedMonthlyPremiumUsd', 'policyTermsSummary', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidInsurancePolicyOffer(incoming()) && (
                         (incoming().insurerUserId == request.auth.uid &&
                          incoming().status == 'quoted' &&
                          exists(/databases/$(database)/documents/insurance_carriers/$(request.auth.uid))) ||
                         (incoming().clientUserId == request.auth.uid &&
                          incoming().status == 'requested')
                       );
      allow update: if isSignedIn() &&
                       isValidId(policyId) &&
                       isValidInsurancePolicyOffer(incoming()) &&
                       incoming().createdAt == existing().createdAt && (
                         ((existing().clientUserId == request.auth.uid || existing().clientUserId == 'open_quote') &&
                          incoming().clientUserId == request.auth.uid &&
                          incoming().insurerUserId == existing().insurerUserId &&
                          incoming().baseMonthlyPremiumUsd == existing().baseMonthlyPremiumUsd &&
                          incoming().discountedMonthlyPremiumUsd == existing().discountedMonthlyPremiumUsd &&
                          incoming().status in ['client_accepted', 'declined'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'clientUserId', 'clientName', 'status', 'updatedAt'
                          ])) ||
                         (existing().insurerUserId == request.auth.uid &&
                          incoming().insurerUserId == existing().insurerUserId &&
                          incoming().status in ['quoted', 'bound', 'declined'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'coverageLimitUsd', 'deductibleUsd', 'baseMonthlyPremiumUsd',
                            'telemetryDiscountPercent', 'discountedMonthlyPremiumUsd',
                            'policyTermsSummary', 'status', 'updatedAt'
                          ]))
                       );
      allow delete: if isSignedIn() && isValidId(policyId) &&
                       (existing().insurerUserId == request.auth.uid || existing().clientUserId == request.auth.uid);
    }

    match /field_scout_applications/{appId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(appId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'applied' &&
                       incoming().keys().hasAll([
                         'userId', 'applicantName', 'city', 'scoutScore', 'verifiedReportsCount',
                         'availabilitySummary', 'coverageNotes', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'applicantName', 'city', 'scoutScore', 'verifiedReportsCount',
                         'availabilitySummary', 'coverageNotes', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFieldScoutApplication(incoming());
      allow update: if isSignedIn() &&
                       isValidId(appId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFieldScoutApplication(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'availabilitySummary', 'coverageNotes', 'status', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && isValidId(appId) && existing().userId == request.auth.uid;
    }
  }
}
