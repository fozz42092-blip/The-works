rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.preferredCity is string && data.preferredCity.size() <= 80 &&
             data.rolePreference in ['resident', 'contractor', 'engineer', 'insurer'] &&
             (!('linkedInsuranceCarrierUid' in data) || (data.linkedInsuranceCarrierUid is string && data.linkedInsuranceCarrierUid.size() <= 128)) &&
             (!('linkedInsuranceCarrierName' in data) || (data.linkedInsuranceCarrierName is string && data.linkedInsuranceCarrierName.size() <= 100)) &&
             (!('linkedPolicyRef' in data) || (data.linkedPolicyRef is string && data.linkedPolicyRef.size() <= 60)) &&
             (!('linkedClaimNumber' in data) || (data.linkedClaimNumber is string && data.linkedClaimNumber.size() <= 60)) &&
             (!('linkedDeductibleUsd' in data) || (data.linkedDeductibleUsd is int && data.linkedDeductibleUsd >= 0 && data.linkedDeductibleUsd <= 100000)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWaterReport(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorRole in ['resident', 'contractor', 'engineer'] &&
             data.visibility in ['community', 'private', 'pending_review', 'flagged'] &&
             data.moderationStatus in ['approved', 'pending_review', 'ai_verified', 'flagged'] &&
             data.moderationNotes is string && data.moderationNotes.size() <= 600 &&
             data.plausibilityScore is int && data.plausibilityScore >= 0 && data.plausibilityScore <= 100 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.stateOrRegion is string && data.stateOrRegion.size() <= 60 &&
             data.addressHint is string && data.addressHint.size() <= 120 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.depthFeet is number && data.depthFeet >= 0.0 && data.depthFeet <= 200.0 &&
             data.soilType in ['clay', 'sand', 'silt', 'loam', 'gravel', 'bedrock', 'unknown'] &&
             data.constructionStage in ['none', 'in_process', 'after_remodel'] &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.situationType in [
               'groundwater_seepage', 'street_flooding', 'basement_intrusion', 'subsurface_test',
               'drainage_backup', 'water_loss', 'mold_growth', 'smoke_soot', 'fire_char'
             ] &&
             data.waterSourceVerdict in [
               'ground_water_table', 'surface_runoff', 'plumbing_leak', 'storm_drain_backup',
               'water_loss_mitigation', 'mold_mitigation', 'smoke_fire_mitigation', 'uncertain'
             ] &&
             data.aiConfidence is int && data.aiConfidence >= 0 && data.aiConfidence <= 100 &&
             data.aiSummary is string && data.aiSummary.size() <= 1500 &&
             data.lossDescription is string && data.lossDescription.size() <= 2500 &&
             data.restorationScope is string && data.restorationScope.size() <= 1500 &&
             data.recommendedSolutions is list && data.recommendedSolutions.size() <= 8 &&
             (data.recommendedSolutions.size() == 0 || data.recommendedSolutions[0] is string) &&
             data.notes is string && data.notes.size() <= 1500 &&
             data.mediaType in ['none', 'photo', 'video'] &&
             data.mediaPreviewBase64 is string && data.mediaPreviewBase64.size() <= 200000 &&
             data.extraPhotosBase64 is list && data.extraPhotosBase64.size() <= 3 &&
             (data.extraPhotosBase64.size() == 0 || (data.extraPhotosBase64[0] is string && data.extraPhotosBase64[0].size() <= 120000)) &&
             data.videoDurationLabel is string && data.videoDurationLabel.size() <= 40 &&
             data.streetFloodRisk in ['low', 'moderate', 'high', 'critical'] &&
             data.upvotesCount is int && data.upvotesCount >= 0 && data.upvotesCount <= 1000000 &&
             data.solutionApplied is string && data.solutionApplied.size() <= 120 &&
             data.solutionWorked is bool &&
             data.engineerVerified is bool &&
             data.verifiedByContractorId is string && data.verifiedByContractorId.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSolutionOutcome(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.reportId is string && data.reportId.size() <= 128 &&
             data.isPublic is bool &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.soilType in ['clay', 'sand', 'silt', 'loam', 'gravel', 'bedrock', 'unknown'] &&
             data.waterSource in [
               'ground_water_table', 'surface_runoff', 'plumbing_leak', 'storm_drain_backup',
               'water_loss_mitigation', 'mold_mitigation', 'smoke_fire_mitigation', 'uncertain'
             ] &&
             data.solutionName is string && data.solutionName.size() >= 2 && data.solutionName.size() <= 120 &&
             data.worked is bool &&
             data.effectivenessScore is int && data.effectivenessScore >= 1 && data.effectivenessScore <= 5 &&
             data.estimatedCostUsd is int && data.estimatedCostUsd >= 0 && data.estimatedCostUsd <= 500000 &&
             data.notes is string && data.notes.size() <= 600 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContractor(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
             data.companyName is string && data.companyName.size() <= 80 &&
             data.specialty in [
               'soil_engineer', 'structural_engineer', 'general_engineer', 'industrial_hygienist',
               'landscaper', 'drainage_contractor', 'leak_specialist', 'water_mitigation',
               'mold_remediation', 'smoke_fire_restoration', 'full_service_restoration',
               'iicrc_inspector', 'plumber', 'roofer', 'foundation_specialist',
               'electrician', 'hvac', 'general_contractor'
             ] &&
             data.licenseNumber is string && data.licenseNumber.size() >= 3 && data.licenseNumber.size() <= 40 &&
             data.licensingState is string && data.licensingState.size() >= 2 && data.licensingState.size() <= 30 &&
             data.cslbBoardStatus in ['unverified', 'format_checked', 'cslb_verified', 'flagged'] &&
             data.cslbLookupUrl is string && data.cslbLookupUrl.size() <= 300 &&
             data.iicrcCertNumber is string && data.iicrcCertNumber.size() <= 40 &&
             data.isIicrcGovernor is bool &&
             data.liveScanStatus in ['not_submitted', 'submitted_ati', 'verified_cleared', 'flagged'] &&
             data.liveScanAtiRef is string && data.liveScanAtiRef.size() <= 40 &&
             data.liveScanAgency is string && data.liveScanAgency.size() <= 100 &&
             data.liveScanClearedDate is string && data.liveScanClearedDate.size() <= 30 &&
             data.liveScanProofBase64 is string && data.liveScanProofBase64.size() <= 160000 &&
             data.primaryCity is string && data.primaryCity.size() >= 1 && data.primaryCity.size() <= 80 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.serviceCities is list && data.serviceCities.size() >= 1 && data.serviceCities.size() <= 10 &&
             data.serviceCities[0] is string &&
             data.consultationFeeUsd is int && data.consultationFeeUsd >= 5 && data.consultationFeeUsd <= 500 &&
             data.platformFeePercent is int && data.platformFeePercent == 10 &&
             data.offersOnSiteWork is bool &&
             data.bio is string && data.bio.size() <= 600 &&
             data.completedReviewsCount is int && data.completedReviewsCount >= 0 && data.completedReviewsCount <= 100000 &&
             data.helpfulContributionsCount is int && data.helpfulContributionsCount >= 0 && data.helpfulContributionsCount <= 1000000 &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidConsultation(data) {
      return data.clientUserId is string && data.clientUserId.size() >= 1 && data.clientUserId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 60 &&
             data.contractorUserId is string && data.contractorUserId.size() >= 1 && data.contractorUserId.size() <= 128 &&
             data.contractorName is string && data.contractorName.size() >= 1 && data.contractorName.size() <= 60 &&
             data.reportId is string && data.reportId.size() >= 1 && data.reportId.size() <= 128 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.serviceMode in ['remote_advice', 'restoration_work'] &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.question is string && data.question.size() >= 5 && data.question.size() <= 1000 &&
             data.status in ['requested', 'reviewed', 'completed', 'cancelled'] &&
             data.engineerVerdict in [
               'pending', 'ground_water_table', 'surface_runoff', 'plumbing_leak',
               'needs_site_boring', 'water_mitigation_approved', 'mold_remediation_approved', 'smoke_fire_approved'
             ] &&
             data.engineerRecommendation is string && data.engineerRecommendation.size() <= 2000 &&
             data.contractorStrategy is string && data.contractorStrategy.size() <= 2000 &&
             data.aiCreditLinks is list && data.aiCreditLinks.size() <= 10 &&
             (data.aiCreditLinks.size() == 0 || (data.aiCreditLinks[0] is string && data.aiCreditLinks[0].size() <= 350)) &&
             data.proposedWorkEstimateUsd is int && data.proposedWorkEstimateUsd >= 0 && data.proposedWorkEstimateUsd <= 250000 &&
             data.contractorFeeUsd is int && data.contractorFeeUsd >= 5 && data.contractorFeeUsd <= 500 &&
             data.platformFeeUsd is int && data.platformFeeUsd >= 1 && data.platformFeeUsd <= 100 &&
             data.totalFeeUsd is int && data.totalFeeUsd == data.contractorFeeUsd + data.platformFeeUsd &&
             data.clientRating is int && data.clientRating >= 0 && data.clientRating <= 5 &&
             data.workAuthStatus in ['none', 'drafted', 'client_authorized', 'completed'] &&
             data.workAuthTerms is string && data.workAuthTerms.size() <= 3500 &&
             data.paymentScheduleSummary is string && data.paymentScheduleSummary.size() <= 600 &&
             data.clientSignatureName is string && data.clientSignatureName.size() <= 80 &&
             data.clientAuthorizedAtLabel is string && data.clientAuthorizedAtLabel.size() <= 40 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidIicrcAudit(data) {
      return data.consultationId is string && data.consultationId.size() >= 1 && data.consultationId.size() <= 128 &&
             data.reportId is string && data.reportId.size() <= 128 &&
             data.contractorUserId is string && data.contractorUserId.size() >= 1 && data.contractorUserId.size() <= 128 &&
             data.contractorName is string && data.contractorName.size() >= 1 && data.contractorName.size() <= 60 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.proposedVerdict is string && data.proposedVerdict.size() <= 60 &&
             data.contractorSuggestion is string && data.contractorSuggestion.size() >= 5 && data.contractorSuggestion.size() <= 2000 &&
             data.contractorStrategy is string && data.contractorStrategy.size() <= 2000 &&
             data.aiCreditLinks is list && data.aiCreditLinks.size() <= 10 &&
             (data.aiCreditLinks.size() == 0 || (data.aiCreditLinks[0] is string && data.aiCreditLinks[0].size() <= 350)) &&
             data.proposedWorkEstimateUsd is int && data.proposedWorkEstimateUsd >= 0 && data.proposedWorkEstimateUsd <= 250000 &&
             data.isPublic is bool && data.isPublic == true &&
             data.iicrcStatus in ['pending_iicrc', 'endorsed', 'revision_requested', 'flagged_outdated'] &&
             data.iicrcStandardRef is string && data.iicrcStandardRef.size() <= 120 &&
             data.iicrcInspectorUid is string && data.iicrcInspectorUid.size() <= 128 &&
             data.iicrcInspectorName is string && data.iicrcInspectorName.size() <= 60 &&
             data.iicrcGovernorNotes is string && data.iicrcGovernorNotes.size() <= 2000 &&
             data.iicrcSources is list && data.iicrcSources.size() <= 10 &&
             (data.iicrcSources.size() == 0 || (data.iicrcSources[0] is string && data.iicrcSources[0].size() <= 350)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContractorReview(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 60 &&
             data.contractorUserId is string && data.contractorUserId.size() >= 1 && data.contractorUserId.size() <= 128 &&
             data.userId != data.contractorUserId &&
             data.contractorName is string && data.contractorName.size() >= 1 && data.contractorName.size() <= 80 &&
             data.companyOrLicenseRef is string && data.companyOrLicenseRef.size() <= 100 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.isPublic is bool && data.isPublic == true &&
             data.workCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration', 'engineering_review'] &&
             data.overallRating is int && data.overallRating >= 1 && data.overallRating <= 5 &&
             data.communicationRating is int && data.communicationRating >= 1 && data.communicationRating <= 5 &&
             data.honestExperience is string && data.honestExperience.size() >= 5 && data.honestExperience.size() <= 1500 &&
             data.proofDescription is string && data.proofDescription.size() <= 300 &&
             data.proofPhotoBase64 is string && data.proofPhotoBase64.size() <= 200000 &&
             data.hasProof is bool &&
             data.wouldRecommend is bool &&
             data.flagShoddyWork is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPortfolioItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.contractorName is string && data.contractorName.size() >= 1 && data.contractorName.size() <= 60 &&
             data.entryType in ['portfolio', 'referral'] &&
             data.isPublic is bool && data.isPublic == true &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.clientReferenceName is string && data.clientReferenceName.size() <= 80 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 1500 &&
             data.completionYear is string && data.completionYear.size() <= 10 &&
             data.photoBase64 is string && data.photoBase64.size() <= 200000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidModerationTicket(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.reportId is string && data.reportId.size() >= 1 && data.reportId.size() <= 128 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.hasMedia is bool &&
             data.isDetailedReport is bool &&
             data.plausibilityScore is int && data.plausibilityScore >= 0 && data.plausibilityScore <= 100 &&
             data.completenessIssues is list && data.completenessIssues.size() <= 10 &&
             (data.completenessIssues.size() == 0 || data.completenessIssues[0] is string) &&
             data.queueStatus in ['pending', 'approved', 'flagged'] &&
             data.aiModerationNotes is string && data.aiModerationNotes.size() <= 600 &&
             data.reviewedByUid is string && data.reviewedByUid.size() <= 128 &&
             data.previewSummary is string && data.previewSummary.size() <= 400 &&
             data.photoBase64 is string && data.photoBase64.size() <= 200000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSupplyOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 60 &&
             data.jobDescription is string && data.jobDescription.size() >= 1 && data.jobDescription.size() <= 1000 &&
             data.shippingCity is string && data.shippingCity.size() >= 1 && data.shippingCity.size() <= 80 &&
             data.shippingAddress is string && data.shippingAddress.size() >= 4 && data.shippingAddress.size() <= 200 &&
             data.itemSummaries is list && data.itemSummaries.size() >= 1 && data.itemSummaries.size() <= 30 &&
             data.itemSummaries[0] is string &&
             data.wholesaleTotalUsd is number && data.wholesaleTotalUsd >= 1.0 && data.wholesaleTotalUsd <= 100000.0 &&
             data.retailBenchmarkUsd is number && data.retailBenchmarkUsd >= 1.0 && data.retailBenchmarkUsd <= 200000.0 &&
             data.totalSavingsUsd is number && data.totalSavingsUsd >= 0.0 && data.totalSavingsUsd <= 100000.0 &&
             data.platformFeeUsd is number && data.platformFeeUsd >= 0.0 && data.platformFeeUsd <= 10000.0 &&
             data.status in ['submitted', 'warehouse_queued', 'shipped', 'cancelled'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContractorComplaint(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.complainantName is string && data.complainantName.size() >= 1 && data.complainantName.size() <= 60 &&
             data.contractorUserId is string && data.contractorUserId.size() >= 1 && data.contractorUserId.size() <= 128 &&
             data.userId != data.contractorUserId &&
             data.contractorName is string && data.contractorName.size() >= 2 && data.contractorName.size() <= 80 &&
             data.companyName is string && data.companyName.size() <= 80 &&
             data.licenseNumber is string && data.licenseNumber.size() <= 40 &&
             data.iicrcCertNumber is string && data.iicrcCertNumber.size() <= 40 &&
             data.isRestorationCompany is bool &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.complaintCategory in [
               'poor_workmanship', 'abandonment', 'unlicensed_work', 'billing_fraud', 'iicrc_violation', 'safety_hazard'
             ] &&
             data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 2000 &&
             data.evidenceNotes is string && data.evidenceNotes.size() <= 600 &&
             data.proofPhotoBase64 is string && data.proofPhotoBase64.size() <= 165000 &&
             data.routedToSocalCslb is bool &&
             data.routedToIicrc is bool &&
             data.cslbIntakeUrl is string && data.cslbIntakeUrl.size() <= 200 &&
             data.iicrcIntakeUrl is string && data.iicrcIntakeUrl.size() <= 200 &&
             data.status in ['filed', 'cslb_portal_opened', 'iicrc_reviewing', 'resolved'] &&
             data.isPublic is bool && data.isPublic == true &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidInsuranceCarrier(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.carrierName is string && data.carrierName.size() >= 2 && data.carrierName.size() <= 100 &&
             data.adjusterName is string && data.adjusterName.size() >= 2 && data.adjusterName.size() <= 60 &&
             data.licenseOrNaicCode is string && data.licenseOrNaicCode.size() <= 40 &&
             data.claimsEmail is string && data.claimsEmail.size() <= 100 &&
             data.claimsPhone is string && data.claimsPhone.size() <= 30 &&
             data.claimsPortalUrl is string && data.claimsPortalUrl.size() <= 250 &&
             data.serviceRegions is list && data.serviceRegions.size() >= 1 && data.serviceRegions.size() <= 10 &&
             data.serviceRegions[0] is string &&
             data.supportsDirectRestorationBilling is bool &&
             data.avgTurnaroundHours is int && data.avgTurnaroundHours >= 1 && data.avgTurnaroundHours <= 336 &&
             data.bio is string && data.bio.size() <= 600 &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidInsuranceClaim(data) {
      return data.clientUserId is string && data.clientUserId.size() >= 1 && data.clientUserId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 60 &&
             data.contractorUserId is string && data.contractorUserId.size() <= 128 &&
             data.contractorName is string && data.contractorName.size() <= 60 &&
             data.insurerUserId is string && data.insurerUserId.size() >= 1 && data.insurerUserId.size() <= 128 &&
             data.insurerName is string && data.insurerName.size() >= 2 && data.insurerName.size() <= 100 &&
             data.claimNumber is string && data.claimNumber.size() >= 2 && data.claimNumber.size() <= 60 &&
             data.policyType in ['homeowners_ho3', 'flood_nfip', 'commercial_property', 'renters'] &&
             data.deductibleUsd is int && data.deductibleUsd >= 0 && data.deductibleUsd <= 100000 &&
             data.reportId is string && data.reportId.size() <= 128 &&
             data.consultationId is string && data.consultationId.size() <= 128 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.lossCategory in ['groundwater', 'water_restoration', 'mold_mitigation', 'smoke_damage', 'fire_restoration'] &&
             data.contractorSuggestion is string && data.contractorSuggestion.size() <= 2000 &&
             data.estimatedScopeUsd is int && data.estimatedScopeUsd >= 0 && data.estimatedScopeUsd <= 250000 &&
             data.approvedCoverageUsd is int && data.approvedCoverageUsd >= 0 && data.approvedCoverageUsd <= 250000 &&
             data.claimStatus in ['linked', 'contractor_scoped', 'insurer_reviewing', 'approved_direct_work', 'supplement_requested'] &&
             data.lastMessageFromRole in ['client', 'contractor', 'insurer'] &&
             data.communicationLog is list && data.communicationLog.size() <= 30 &&
             (data.communicationLog.size() == 0 || (data.communicationLog[0] is string && data.communicationLog[0].size() <= 400)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSavedProperty(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
             data.propertyType in ['house', 'business'] &&
             data.address is string && data.address.size() <= 160 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.state is string && data.state.size() <= 40 &&
             data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
             data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
             data.femaFloodZone is string && data.femaFloodZone.size() <= 120 &&
             data.fireHazardZone is string && data.fireHazardZone.size() <= 120 &&
             data.waterTableDepthFt is number && data.waterTableDepthFt >= 0.0 && data.waterTableDepthFt <= 200.0 &&
             data.hazardSummary is string && data.hazardSummary.size() <= 800 &&
             data.notifyPriorityAlerts is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContractorProductReview(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.contractorName is string && data.contractorName.size() >= 1 && data.contractorName.size() <= 60 &&
             data.companyName is string && data.companyName.size() <= 80 &&
             data.licenseNumber is string && data.licenseNumber.size() <= 40 &&
             data.productSku is string && data.productSku.size() >= 1 && data.productSku.size() <= 60 &&
             data.productName is string && data.productName.size() >= 2 && data.productName.size() <= 120 &&
             data.brandModel is string && data.brandModel.size() <= 80 &&
             data.category is string && data.category.size() <= 60 &&
             data.disasterUseCase in ['flooding', 'wildfire_smoke', 'mold_cleanse', 'groundwater'] &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.jobsUsedCount is int && data.jobsUsedCount >= 1 && data.jobsUsedCount <= 5000 &&
             data.pros is string && data.pros.size() <= 400 &&
             data.cons is string && data.cons.size() <= 400 &&
             data.honestReview is string && data.honestReview.size() >= 5 && data.honestReview.size() <= 1500 &&
             data.wouldUseOnInsuredJob is bool &&
             data.isPublic is bool && data.isPublic == true &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEquipmentRental(data) {
      return data.ownerUserId is string && data.ownerUserId.size() >= 1 && data.ownerUserId.size() <= 128 &&
             data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 60 &&
             data.ownerType in ['restoration_company', 'resident'] &&
             data.companyName is string && data.companyName.size() <= 80 &&
             data.equipmentName is string && data.equipmentName.size() >= 2 && data.equipmentName.size() <= 100 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 40 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.dailyRateUsd is int && data.dailyRateUsd >= 5 && data.dailyRateUsd <= 2500 &&
             data.depositUsd is int && data.depositUsd >= 0 && data.depositUsd <= 10000 &&
             data.specs is string && data.specs.size() <= 500 &&
             data.contactPhoneOrNote is string && data.contactPhoneOrNote.size() <= 120 &&
             data.isAvailable is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAppRevisionSuggestion(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorRole in ['contractor', 'resident', 'insurer', 'iicrc_inspector'] &&
             data.tradeOrSpecialty is string && data.tradeOrSpecialty.size() <= 60 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.category in ['Workflow', 'AI Diagnostics', 'Safety & Licensing', 'Insurance', 'Equipment & DIY'] &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 1200 &&
             data.upvotesCount is int && data.upvotesCount >= 0 && data.upvotesCount <= 1000000 &&
             data.status in ['submitted', 'planned', 'shipped'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidHygienistRequest(data) {
      return data.clientUserId is string && data.clientUserId.size() >= 1 && data.clientUserId.size() <= 128 &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 60 &&
             data.hygienistUserId is string && data.hygienistUserId.size() >= 1 && data.hygienistUserId.size() <= 128 &&
             data.hygienistName is string && data.hygienistName.size() <= 60 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.propertyAddressHint is string && data.propertyAddressHint.size() <= 160 &&
             data.sampleTypes is list && data.sampleTypes.size() >= 1 && data.sampleTypes.size() <= 6 &&
             data.sampleTypes[0] is string &&
             data.reasonNotes is string && data.reasonNotes.size() <= 800 &&
             data.status in ['requested', 'accepted', 'sampled', 'lab_report_ready', 'cancelled'] &&
             data.quotedFeeUsd is int && data.quotedFeeUsd >= 0 && data.quotedFeeUsd <= 15000 &&
             data.labFindingsSummary is string && data.labFindingsSummary.size() <= 1500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidInsurancePolicyOffer(data) {
      return data.insurerUserId is string && data.insurerUserId.size() >= 1 && data.insurerUserId.size() <= 128 &&
             data.carrierName is string && data.carrierName.size() >= 2 && data.carrierName.size() <= 100 &&
             data.clientUserId is string && data.clientUserId.size() >= 1 && data.clientUserId.size() <= 128 &&
             data.clientName is string && data.clientName.size() <= 60 &&
             data.propertyLabel is string && data.propertyLabel.size() >= 1 && data.propertyLabel.size() <= 120 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.coverageType in ['homeowners_ho3', 'flood_nfip', 'wildfire_dic', 'landlord'] &&
             data.coverageLimitUsd is int && data.coverageLimitUsd >= 10000 && data.coverageLimitUsd <= 10000000 &&
             data.deductibleUsd is int && data.deductibleUsd >= 0 && data.deductibleUsd <= 100000 &&
             data.baseMonthlyPremiumUsd is int && data.baseMonthlyPremiumUsd >= 10 && data.baseMonthlyPremiumUsd <= 25000 &&
             data.telemetryDiscountPercent is int && data.telemetryDiscountPercent >= 0 && data.telemetryDiscountPercent <= 45 &&
             data.discountedMonthlyPremiumUsd is int && data.discountedMonthlyPremiumUsd >= 10 && data.discountedMonthlyPremiumUsd <= 25000 &&
             data.policyTermsSummary is string && data.policyTermsSummary.size() <= 1000 &&
             data.status in ['requested', 'quoted', 'client_accepted', 'bound', 'declined'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFieldScoutApplication(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.applicantName is string && data.applicantName.size() >= 2 && data.applicantName.size() <= 60 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.scoutScore is int && data.scoutScore >= 0 && data.scoutScore <= 1000000 &&
             data.verifiedReportsCount is int && data.verifiedReportsCount >= 0 && data.verifiedReportsCount <= 100000 &&
             data.availabilitySummary is string && data.availabilitySummary.size() >= 2 && data.availabilitySummary.size() <= 300 &&
             data.coverageNotes is string && data.coverageNotes.size() <= 800 &&
             data.status in ['applied', 'active_paid_scout', 'paused'] &&
             isValidTimestamp(data.createdAt) &&
